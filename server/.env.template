# Google oauth
# - Create a Google Cloud project, create credentials for a "web application", and put the client id and secret here
# - Your project should have the following scopes:
#     "./auth/calendar.events" (read/write - needed to create the scheduled Google Calendar
#       event + Meet link and invite respondents; superset of calendar.events.readonly)
#     "./auth/calendar.calendarlist.readonly"
#     "./auth/contacts.readonly"
#     "./auth/directory.readonly"
CLIENT_ID=?
CLIENT_SECRET=?

# Microsoft oauth (optional, for Outlook calendars)
MICROSOFT_CLIENT_ID=? # optional
MICROSOFT_CLIENT_SECRET=? # optional

# Gmail SMTP
# - Currently unused: no notification emails are sent. Kept as the hook for
#   reintroducing email via utils.SendEmail.
GMAIL_APP_PASSWORD=? # optional
SCHEJ_EMAIL_ADDRESS=? # optional

# Analytics routes basic auth
ANALYTICS_USERNAME=? # optional
ANALYTICS_PASSWORD=? # optional

# Encryption
# - Must be exactly 16, 24, or 32 raw characters (AES key size)
# - Example generation: openssl rand -hex 16
ENCRYPTION_KEY=?

# Session
# - Generate a random 32+ character string for session cookie encryption
# - Example generation: openssl rand -base64 32
SESSION_SECRET=?

# Data retention
# - Days to keep an event after its last possible meeting date has passed
# - Expired events are deleted permanently, along with their responses, attendees,
#   and folder associations. Day of week events and availability groups never expire.
# - Set to 0 to keep events forever
EVENT_RETENTION_DAYS=30 # optional, defaults to 30

# CORS
# - Comma-separated list of allowed origins
# - For local development, set to: http://localhost:8080
CORS_ORIGINS=?
